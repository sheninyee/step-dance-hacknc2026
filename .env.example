# Get a Gemini API key
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional override if your project uses another Gemini Live audio model:
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
PORT=3000
# ElevenLabs voice for page announcements (voice id is optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Snowflake Cortex REST API practice tips (account identifier and a programmatic access token)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
# Tiger Data Postgres connection string for the practice log
TIGER_DATA_URL=
